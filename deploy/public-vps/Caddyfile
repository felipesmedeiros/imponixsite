{
  admin off
  auto_https off
}
http://:8081 {
  bind 127.0.0.1
  root * /srv/imponix/current/site
  encode zstd gzip
  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Cache-Control "public, max-age=0, must-revalidate"
  }
  @insecure header X-Forwarded-Proto http
  redir @insecure https://imponix.com{uri} permanent
  @www host www.imponix.com
  redir @www https://imponix.com{uri} permanent
  @trailing path_regexp trailing ^(.+)/$
  redir @trailing {re.trailing.1}?{query} 308
  @private path /observatory /observatory/* /api/*
  respond @private 404
  @internal path /.git/* /.env* /.vite/* /release.json
  respond @internal 404
  handle /_next/static/* {
    root * /srv/imponix/shared
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }
  @flight header RSC 1
  handle @flight {
    header Content-Type text/x-component
    header Vary "RSC, Accept-Encoding"
    @root path /
    rewrite @root /index
    try_files {path}.rsc {path}/index.rsc {path} =404
    file_server
  }
  handle {
    @rsc path *.rsc
    header @rsc Content-Type text/x-component
    header Vary "RSC, Accept-Encoding"
    try_files {path}.html {path} {path}/index.html =404
    file_server
  }
  handle_errors {
    rewrite * /404.html
    file_server
  }
}
